Include ~/.ssh/config.d/*

Host *
	ServerAliveInterval 60
	ServerAliveCountMax 3
	StrictHostKeyChecking no
	IdentityFile ~/.ssh/id_ed25519

{{ if eq .chezmoi.hostname "aarons-air" -}}
Host aarons-work-vm.local
	ProxyJump aarons-work.local
{{ else if eq .chezmoi.hostname "aarons-work" -}}
Host aarons-air-vm.local
	ProxyJump aarons-air.local
{{ end -}}
